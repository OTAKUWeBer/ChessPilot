cmake_minimum_required(VERSION 3.18)

# Run explicitly before a desktop build; normal CMake builds never download code.
get_filename_component(native "${CMAKE_CURRENT_LIST_DIR}/../native" ABSOLUTE)
cmake_host_system_information(RESULT host_arch QUERY OS_PLATFORM)
if(NOT CHESSPILOT_DESKTOP_PLATFORM)
  if(CMAKE_HOST_SYSTEM_NAME STREQUAL "Windows")
    if(host_arch MATCHES "^(aarch64|arm64|ARM64)$")
      set(CHESSPILOT_DESKTOP_PLATFORM windows-arm64)
    else()
      set(CHESSPILOT_DESKTOP_PLATFORM windows-x64)
    endif()
  elseif(CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux")
    if(host_arch MATCHES "^(aarch64|arm64)$")
      set(CHESSPILOT_DESKTOP_PLATFORM linux-arm64)
    else()
      set(CHESSPILOT_DESKTOP_PLATFORM linux-x64)
    endif()
  else()
    message(FATAL_ERROR "Desktop builds currently support Windows and Linux")
  endif()
endif()

if(CHESSPILOT_DESKTOP_PLATFORM STREQUAL "windows-x64")
  set(package onnxruntime-win-x64-1.20.1)
  set(extension zip)
  set(digest 78d447051e48bd2e1e778bba378bec4ece11191c9e538cf7b2c4a4565e8f5581)
  set(nuget_rid win-x64)
elseif(CHESSPILOT_DESKTOP_PLATFORM STREQUAL "windows-arm64")
  set(package onnxruntime-win-arm64-1.20.1)
  set(extension zip)
  set(digest 21ded41cf725dec14bf138f891438afd06f5363fe8b2477049e7262bd7238ce2)
  set(nuget_rid win-arm64)
elseif(CHESSPILOT_DESKTOP_PLATFORM STREQUAL "linux-x64")
  set(package onnxruntime-linux-x64-1.20.1)
  set(extension tgz)
  set(digest 67db4dc1561f1e3fd42e619575c82c601ef89849afc7ea85a003abbac1a1a105)
  set(nuget_rid linux-x64)
elseif(CHESSPILOT_DESKTOP_PLATFORM STREQUAL "linux-arm64")
  set(package onnxruntime-linux-aarch64-1.20.1)
  set(extension tgz)
  set(digest ae4fedbdc8c18d688c01306b4b50c63de3445cdf2dbd720e01a2fa3810b8106a)
  set(nuget_rid linux-arm64)
else()
  message(FATAL_ERROR "Unknown CHESSPILOT_DESKTOP_PLATFORM: ${CHESSPILOT_DESKTOP_PLATFORM}")
endif()

file(MAKE_DIRECTORY "${native}/target")

set(archive "${native}/target/${package}.${extension}")
set(url "https://github.com/microsoft/onnxruntime/releases/download/v1.20.1/${package}.${extension}")

set(nuget_package "microsoft.ml.onnxruntime.1.20.1.nupkg")
set(nuget_archive "${native}/target/${nuget_package}")
set(nuget_digest 9c32108e9a1c78b090a95c2a219f244dd5f067d4caf68fb0f967103f3f20839c)
set(nuget_urls
  "https://www.nuget.org/api/v2/package/Microsoft.ML.OnnxRuntime/1.20.1"
  "https://api.nuget.org/v3-flatcontainer/microsoft.ml.onnxruntime/1.20.1/microsoft.ml.onnxruntime.1.20.1.nupkg"
)

set(source_format "")
set(used_archive "")
set(source_url "")
set(source_digest "")

# Check cached archives first
if(EXISTS "${archive}")
  file(SHA256 "${archive}" actual)
  if(actual STREQUAL digest)
    set(used_archive "${archive}")
    set(source_format "github")
    set(source_url "${url}")
    set(source_digest "${digest}")
  else()
    message(WARNING "Cached GitHub archive hash mismatch, removing: ${archive}")
    file(REMOVE "${archive}")
  endif()
endif()

if(NOT used_archive AND EXISTS "${nuget_archive}")
  file(SHA256 "${nuget_archive}" actual)
  if(actual STREQUAL nuget_digest)
    set(used_archive "${nuget_archive}")
    set(source_format "nuget")
    set(source_url "https://www.nuget.org/api/v2/package/Microsoft.ML.OnnxRuntime/1.20.1")
    set(source_digest "${nuget_digest}")
  else()
    message(WARNING "Cached NuGet archive hash mismatch, removing: ${nuget_archive}")
    file(REMOVE "${nuget_archive}")
  endif()
endif()

# Try downloading from GitHub
if(NOT used_archive)
  message(STATUS "Downloading ONNX Runtime from GitHub: ${url}")
  file(DOWNLOAD "${url}" "${archive}.part"
    TLS_VERIFY ON TIMEOUT 180 INACTIVITY_TIMEOUT 20 STATUS gh_result SHOW_PROGRESS)
  list(GET gh_result 0 gh_code)
  if(gh_code EQUAL 0)
    file(SHA256 "${archive}.part" actual)
    if(actual STREQUAL digest)
      file(RENAME "${archive}.part" "${archive}")
      set(used_archive "${archive}")
      set(source_format "github")
      set(source_url "${url}")
      set(source_digest "${digest}")
    else()
      message(WARNING "Downloaded GitHub archive hash mismatch: ${actual} vs ${digest}")
      file(REMOVE "${archive}.part")
    endif()
  else()
    message(STATUS "GitHub download failed: ${gh_result}")
    file(REMOVE "${archive}.part")
  endif()
endif()

# Fallback to NuGet if GitHub download is unavailable
if(NOT used_archive)
  foreach(nuget_url IN LISTS nuget_urls)
    message(STATUS "Attempting fallback download from NuGet: ${nuget_url}")
    file(DOWNLOAD "${nuget_url}" "${nuget_archive}.part"
      TLS_VERIFY ON TIMEOUT 180 INACTIVITY_TIMEOUT 20 STATUS ng_result SHOW_PROGRESS)
    list(GET ng_result 0 ng_code)
    if(ng_code EQUAL 0)
      file(SHA256 "${nuget_archive}.part" actual)
      if(actual STREQUAL nuget_digest)
        file(RENAME "${nuget_archive}.part" "${nuget_archive}")
        set(used_archive "${nuget_archive}")
        set(source_format "nuget")
        set(source_url "${nuget_url}")
        set(source_digest "${nuget_digest}")
        break()
      else()
        message(WARNING "Downloaded NuGet archive hash mismatch: ${actual} vs ${nuget_digest}")
        file(REMOVE "${nuget_archive}.part")
      endif()
    else()
      message(STATUS "NuGet download from ${nuget_url} failed: ${ng_result}")
      file(REMOVE "${nuget_archive}.part")
    endif()
  endforeach()
endif()

if(NOT used_archive)
  message(FATAL_ERROR "ONNX Runtime 1.20.1 download failed from both GitHub and NuGet")
endif()

set(extracted "${native}/target/desktop-tools/${CHESSPILOT_DESKTOP_PLATFORM}")
set(destination "${native}/target/desktop-assets/${CHESSPILOT_DESKTOP_PLATFORM}")
file(MAKE_DIRECTORY "${destination}/licenses")

if(source_format STREQUAL "github")
  if(extension STREQUAL zip)
    set(library_patterns "${package}/lib/*.dll")
  else()
    set(library_patterns "${package}/lib/libonnxruntime.so.1.20.1" "${package}/lib/libonnxruntime_providers_shared.so")
  endif()
  file(ARCHIVE_EXTRACT INPUT "${used_archive}" DESTINATION "${extracted}"
    PATTERNS ${library_patterns}
      "${package}/LICENSE" "${package}/ThirdPartyNotices.txt")

  if(extension STREQUAL zip)
    file(COPY "${extracted}/${package}/lib/onnxruntime.dll"
      "${extracted}/${package}/lib/onnxruntime_providers_shared.dll" DESTINATION "${destination}")
  else()
    # Flatten the SONAME symlink chain for portable archives and Windows-hosted preparation.
    configure_file("${extracted}/${package}/lib/libonnxruntime.so.1.20.1"
      "${destination}/libonnxruntime.so" COPYONLY)
    if(EXISTS "${extracted}/${package}/lib/libonnxruntime_providers_shared.so")
      file(COPY "${extracted}/${package}/lib/libonnxruntime_providers_shared.so" DESTINATION "${destination}")
    endif()
  endif()
  configure_file("${extracted}/${package}/LICENSE" "${destination}/licenses/ONNXRuntime-LICENSE.txt" COPYONLY)
  configure_file("${extracted}/${package}/ThirdPartyNotices.txt" "${destination}/licenses/ONNXRuntime-ThirdPartyNotices.txt" COPYONLY)
else()
  if(CHESSPILOT_DESKTOP_PLATFORM MATCHES "^windows")
    set(library_patterns "runtimes/${nuget_rid}/native/*.dll")
  else()
    set(library_patterns "runtimes/${nuget_rid}/native/libonnxruntime.so" "runtimes/${nuget_rid}/native/libonnxruntime_providers_shared.so")
  endif()
  file(ARCHIVE_EXTRACT INPUT "${used_archive}" DESTINATION "${extracted}"
    PATTERNS ${library_patterns}
      "LICENSE" "ThirdPartyNotices.txt")

  if(CHESSPILOT_DESKTOP_PLATFORM MATCHES "^windows")
    file(COPY "${extracted}/runtimes/${nuget_rid}/native/onnxruntime.dll" DESTINATION "${destination}")
    if(EXISTS "${extracted}/runtimes/${nuget_rid}/native/onnxruntime_providers_shared.dll")
      file(COPY "${extracted}/runtimes/${nuget_rid}/native/onnxruntime_providers_shared.dll" DESTINATION "${destination}")
    endif()
  else()
    configure_file("${extracted}/runtimes/${nuget_rid}/native/libonnxruntime.so"
      "${destination}/libonnxruntime.so" COPYONLY)
    if(EXISTS "${extracted}/runtimes/${nuget_rid}/native/libonnxruntime_providers_shared.so")
      file(COPY "${extracted}/runtimes/${nuget_rid}/native/libonnxruntime_providers_shared.so" DESTINATION "${destination}")
    endif()
  endif()
  configure_file("${extracted}/LICENSE" "${destination}/licenses/ONNXRuntime-LICENSE.txt" COPYONLY)
  configure_file("${extracted}/ThirdPartyNotices.txt" "${destination}/licenses/ONNXRuntime-ThirdPartyNotices.txt" COPYONLY)
endif()

file(WRITE "${destination}/licenses/ONNXRuntime-SOURCE.txt"
  "ONNX Runtime 1.20.1, MIT\nArchive: ${source_url}\nSHA256: ${source_digest}\nSource: https://github.com/microsoft/onnxruntime/tree/v1.20.1\n")
message(STATUS "Prepared ${destination}")
